{
  "id": "org",
  "type": "typesetter",
  "name": "Org Mode",
  "iconUrl": "https://texlyre.github.io/chelys-recipes/recipes/typesetter/org/icon.svg",
  "description": "Exports Org documents to PDF with TeX Live and to HTML, LaTeX, and Markdown through GNU Emacs Org Mode.",
  "notes": "Org Mode runs inside a Docker container alongside the shared Chelys typesetter bridge (ghcr.io/texlyre/chelys-typeset-bridge:1) and an Org-specific engine adapter. The image pins Org 9.8.7 from GNU ELPA and uses the same texlive/texlive:latest-full base as the TeX Live and Sphinx recipes. PDF preview first exports the Org document to LaTeX and then runs latexmk with the selected pdfLaTeX, LuaLaTeX, or XeLaTeX engine, so standard TeX Live packages, BibTeX, and Biber are available. HTML, LaTeX, and Markdown are download-only export targets. Babel evaluation is disabled by default so source blocks are rendered but not executed; it can be explicitly enabled for trusted documents. The bridge keeps a per-connection working tree and reconciles it against the manifest TeXlyre sends, so only changed files travel after the first compile. When options.action is 'clear-cache' the tree is wiped and status 0 returned without compiling.",
  "tags": [
    "org",
    "org-mode",
    "emacs",
    "typesetting",
    "pdf",
    "html",
    "latex",
    "markdown"
  ],
  "author": "TeXlyre",
  "version": "9.8.7",
  "lastUpdated": "2026-08-27T14:50:00Z",
  "variables": [
    {
      "key": "wsPort",
      "label": "WebSocket port",
      "kind": "number",
      "default": "7049",
      "help": "Port the compile bridge listens on."
    }
  ],
  "env": {},
  "extraFiles": [
    "engine.cjs"
  ],
  "modes": [
    {
      "kind": "docker",
      "image": "ghcr.io/texlyre/chelys-recipe-org:9.8.7",
      "dockerfileUrl": "Dockerfile",
      "buildSteps": [],
      "runArgs": [
        "-p",
        "${wsPort}:${wsPort}",
        "-e",
        "WS_PORT=${wsPort}"
      ]
    },
    {
      "kind": "connect"
    }
  ],
  "typeConfig": {
    "configId": "org",
    "projectType": "org",
    "inputExtensions": [
      "org"
    ],
    "inputFiles": [
      {
        "extension": "org",
        "label": {
          "key": "{typesetter} File",
          "params": {
            "typesetter": "Org"
          }
        },
        "mimeType": "text/x-org"
      }
    ],
    "outputFormats": [
      {
        "id": "pdf",
        "mimeType": "application/pdf",
        "rendererPluginId": "pdf-renderer"
      },
      {
        "id": "canvas-pdf",
        "mimeType": "application/pdf",
        "rendererPluginId": "canvas-renderer",
        "outputType": "canvas"
      },
      {
        "id": "html",
        "mimeType": "text/html"
      },
      {
        "id": "latex",
        "mimeType": "application/x-tex"
      },
      {
        "id": "markdown",
        "mimeType": "text/markdown"
      }
    ],
    "transportType": "websocket",
    "transportUrl": "ws://localhost:${wsPort}",
    "incrementalSync": true,
    "formatter": "",
    "hasOutline": false,
    "ui": {
      "compile": {
        "fields": [
          {
            "key": "format",
            "label": "Output Format:",
            "kind": "select",
            "sendAs": "format",
            "defaultValue": "pdf",
            "options": [
              {
                "label": "PDF",
                "value": "pdf"
              },
              {
                "label": "Canvas (PDF)",
                "value": "canvas-pdf"
              }
            ]
          },
          {
            "key": "latexEngine",
            "label": {
              "key": "{typesetter} Engine:",
              "params": {
                "typesetter": "LaTeX"
              }
            },
            "kind": "select",
            "sendAs": "option",
            "defaultValue": "pdflatex",
            "options": [
              {
                "label": "pdfLaTeX",
                "value": "pdflatex"
              },
              {
                "label": "LuaLaTeX",
                "value": "lualatex"
              },
              {
                "label": "XeLaTeX",
                "value": "xelatex"
              }
            ]
          },
          {
            "key": "babel",
            "label": {
              "key": "Evaluate Babel blocks"
            },
            "kind": "boolean",
            "sendAs": "option",
            "defaultValue": false,
            "help": {
              "key": "Executes source blocks during export. Enable only for trusted documents and languages available in the image."
            }
          }
        ]
      },
      "export": {
        "label": "Export",
        "fields": [
          {
            "key": "format",
            "label": "Export Format:",
            "kind": "select",
            "sendAs": "format",
            "defaultValue": "pdf",
            "options": [
              {
                "label": "PDF",
                "value": "pdf"
              },
              {
                "label": "HTML",
                "value": "html"
              },
              {
                "label": "LaTeX",
                "value": "latex"
              },
              {
                "label": "Markdown",
                "value": "markdown"
              }
            ]
          },
          {
            "key": "latexEngine",
            "label": {
              "key": "{typesetter} Engine:",
              "params": {
                "typesetter": "LaTeX"
              }
            },
            "kind": "select",
            "sendAs": "option",
            "defaultValue": "pdflatex",
            "options": [
              {
                "label": "pdfLaTeX",
                "value": "pdflatex"
              },
              {
                "label": "LuaLaTeX",
                "value": "lualatex"
              },
              {
                "label": "XeLaTeX",
                "value": "xelatex"
              }
            ],
            "showWhen": {
              "field": "format",
              "in": [
                "pdf",
                "latex"
              ]
            }
          },
          {
            "key": "babel",
            "label": {
              "key": "Evaluate Babel blocks"
            },
            "kind": "boolean",
            "sendAs": "option",
            "defaultValue": false,
            "help": {
              "key": "Executes source blocks during export. Enable only for trusted documents and languages available in the image."
            }
          },
          {
            "key": "includeLog",
            "label": {
              "key": "Include log file"
            },
            "kind": "boolean",
            "sendAs": "option",
            "defaultValue": false
          }
        ]
      },
      "renderers": [
        {
          "format": "pdf",
          "label": "PDF"
        },
        {
          "format": "canvas-pdf",
          "label": "Canvas (PDF)"
        }
      ],
      "info": {
        "title": "Org Mode",
        "rows": [
          {
            "label": {
              "key": "{typesetter} Engine:",
              "params": {
                "typesetter": "Org"
              }
            },
            "value": {
              "key": "Org Mode 9.8.7 (GNU Emacs)"
            }
          },
          {
            "label": {
              "key": "PDF Toolchain:"
            },
            "value": {
              "key": "TeX Live full + latexmk"
            }
          },
          {
            "label": {
              "key": "Input Format:"
            },
            "value": {
              "key": "Org Mode (.org)"
            }
          },
          {
            "label": {
              "key": "Output Formats:"
            },
            "value": {
              "key": "PDF, Canvas (PDF)"
            }
          },
          {
            "label": {
              "key": "Export Formats:"
            },
            "value": {
              "key": "PDF, HTML, LaTeX, Markdown"
            }
          }
        ]
      }
    }
  }
}
