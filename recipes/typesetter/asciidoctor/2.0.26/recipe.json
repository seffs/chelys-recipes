{
    "id": "asciidoctor",
    "type": "typesetter",
    "name": "Asciidoctor (AsciiDoc)",
    "iconUrl": "https://texlyre.github.io/chelys-recipes/recipes/typesetter/asciidoctor/icon.svg",
    "description": "Compiles AsciiDoc documents to PDF, and exports HTML, EPUB, reveal.js slides, and Word DOCX.",
    "notes": "Asciidoctor runs inside a Docker container alongside the shared Chelys typesetter bridge (ghcr.io/texlyre/chelys-typeset-bridge:1) and an AsciiDoc-specific engine adapter. Each output format is produced by its own converter: asciidoctor-pdf for PDF, asciidoctor for single-file HTML5 with data-uri assets, asciidoctor-epub3 for EPUB, asciidoctor-revealjs for slides, and asciidoctor plus pandoc via DocBook for DOCX. Preview is PDF only; the other targets are download-only via Export. The asciidoctor-diagram and asciidoctor-bibtex extensions are required by default, so ditaa, Graphviz, and PlantUML blocks and bibtex-file citations work without per-document configuration; the image includes Graphviz and a headless JRE for them. Rouge, CodeRay, and Pygments are available as source highlighters, and Ghostscript backs the PDF optimizer. Further converters, extensions, or PDF themes are added through the Extra gems variable, which is appended to the gem install when the image is built; the prebuilt image only carries the defaults, so setting it builds locally instead of pulling. Safe mode defaults to 'safe', which keeps includes and diagram generation inside the project directory. The bridge keeps a per-connection working tree and reconciles it against the manifest TeXlyre sends, so only changed files travel after the first compile. When options.action is 'clear-cache' the tree is wiped and status 0 returned without compiling.",
    "tags": [
        "asciidoc",
        "asciidoctor",
        "typesetting",
        "pdf",
        "html",
        "epub",
        "docx"
    ],
    "author": "TeXlyre",
    "version": "2.0.26",
    "lastUpdated": "2026-08-03T10:00:00Z",
    "variables": [
        {
            "key": "wsPort",
            "label": "WebSocket port",
            "kind": "number",
            "default": "7047",
            "help": "Port the compile bridge listens on."
        },
        {
            "key": "gemPackages",
            "label": "Extra gems",
            "kind": "text",
            "default": "",
            "help": "Space-separated gems added to the image, e.g. 'asciidoctor-kroki asciidoctor-lists'."
        }
    ],
    "env": {},
    "extraFiles": [
        "engine.cjs"
    ],
    "modes": [
        {
            "kind": "docker",
            "image": "ghcr.io/texlyre/chelys-recipe-asciidoctor:2.0.26",
            "dockerfileUrl": "Dockerfile",
            "buildSteps": [],
            "runArgs": [
                "-p",
                "${wsPort}:${wsPort}",
                "-e",
                "WS_PORT=${wsPort}"
            ]
        },
        {
            "kind": "connect"
        }
    ],
    "typeConfig": {
        "configId": "asciidoctor",
        "projectType": "asciidoc",
        "inputExtensions": [
            "adoc",
            "asciidoc",
            "asc"
        ],
        "inputFiles": [
            {
                "extension": "adoc",
                "label": {
                    "key": "{typesetter} File",
                    "params": {
                        "typesetter": "AsciiDoc"
                    }
                },
                "mimeType": "text/x-asciidoc"
            }
        ],
        "outputFormats": [
            {
                "id": "pdf",
                "mimeType": "application/pdf",
                "rendererPluginId": "pdf-renderer"
            },
            {
                "id": "canvas-pdf",
                "mimeType": "application/pdf",
                "rendererPluginId": "canvas-renderer",
                "outputType": "canvas"
            },
            {
                "id": "html",
                "mimeType": "text/html"
            },
            {
                "id": "epub",
                "mimeType": "application/epub+zip"
            },
            {
                "id": "revealjs",
                "mimeType": "text/html"
            },
            {
                "id": "docx",
                "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
            }
        ],
        "transportType": "websocket",
        "transportUrl": "ws://localhost:${wsPort}",
        "incrementalSync": true,
        "formatter": "",
        "hasOutline": false,
        "ui": {
            "compile": {
                "fields": [
                    {
                        "key": "format",
                        "label": "Output Format:",
                        "kind": "select",
                        "sendAs": "format",
                        "defaultValue": "pdf",
                        "options": [
                            {
                                "label": "PDF",
                                "value": "pdf"
                            },
                            {
                                "label": "Canvas (PDF)",
                                "value": "canvas-pdf"
                            }
                        ]
                    },
                    {
                        "key": "doctype",
                        "label": {
                            "key": "Document Type:"
                        },
                        "kind": "select",
                        "sendAs": "option",
                        "defaultValue": "article",
                        "options": [
                            {
                                "label": "Article",
                                "value": "article"
                            },
                            {
                                "label": "Book",
                                "value": "book"
                            },
                            {
                                "label": "Manpage",
                                "value": "manpage"
                            }
                        ]
                    },
                    {
                        "key": "attributes",
                        "label": {
                            "key": "Attributes:"
                        },
                        "kind": "text",
                        "sendAs": "option",
                        "defaultValue": "",
                        "help": {
                            "key": "Space-separated attributes, e.g. source-highlighter=rouge toc=left."
                        }
                    },
                    {
                        "key": "extensions",
                        "label": {
                            "key": "Load diagram and bibtex extensions"
                        },
                        "kind": "boolean",
                        "sendAs": "option",
                        "defaultValue": true,
                        "help": {
                            "key": "Required by ditaa, Graphviz, and PlantUML blocks and by bibtex-file citations."
                        }
                    },
                    {
                        "key": "safeMode",
                        "label": {
                            "key": "Safe mode"
                        },
                        "kind": "boolean",
                        "sendAs": "option",
                        "defaultValue": true,
                        "help": {
                            "key": "Restricts includes and generated assets to the project directory."
                        }
                    }
                ]
            },
            "export": {
                "label": "Export",
                "fields": [
                    {
                        "key": "format",
                        "label": "Export Format:",
                        "kind": "select",
                        "sendAs": "format",
                        "defaultValue": "pdf",
                        "options": [
                            {
                                "label": "PDF",
                                "value": "pdf"
                            },
                            {
                                "label": "HTML (single file)",
                                "value": "html"
                            },
                            {
                                "label": "EPUB",
                                "value": "epub"
                            },
                            {
                                "label": "reveal.js slides",
                                "value": "revealjs"
                            },
                            {
                                "label": "Word (DOCX)",
                                "value": "docx"
                            }
                        ]
                    },
                    {
                        "key": "doctype",
                        "label": {
                            "key": "Document Type:"
                        },
                        "kind": "select",
                        "sendAs": "option",
                        "defaultValue": "article",
                        "options": [
                            {
                                "label": "Article",
                                "value": "article"
                            },
                            {
                                "label": "Book",
                                "value": "book"
                            },
                            {
                                "label": "Manpage",
                                "value": "manpage"
                            }
                        ]
                    },
                    {
                        "key": "attributes",
                        "label": {
                            "key": "Attributes:"
                        },
                        "kind": "text",
                        "sendAs": "option",
                        "defaultValue": ""
                    },
                    {
                        "key": "optimize",
                        "label": {
                            "key": "Optimize PDF"
                        },
                        "kind": "boolean",
                        "sendAs": "option",
                        "defaultValue": false,
                        "showWhen": {
                            "field": "format",
                            "in": [
                                "pdf"
                            ]
                        },
                        "help": {
                            "key": "Runs the Ghostscript-backed optimizer. Slower, smaller output."
                        }
                    },
                    {
                        "key": "extensions",
                        "label": {
                            "key": "Load diagram and bibtex extensions"
                        },
                        "kind": "boolean",
                        "sendAs": "option",
                        "defaultValue": true
                    },
                    {
                        "key": "includeLog",
                        "label": {
                            "key": "Include log file"
                        },
                        "kind": "boolean",
                        "sendAs": "option",
                        "defaultValue": false
                    }
                ]
            },
            "renderers": [
                {
                    "format": "pdf",
                    "label": "PDF"
                },
                {
                    "format": "canvas-pdf",
                    "label": "Canvas (PDF)"
                }
            ],
            "info": {
                "title": "AsciiDoc",
                "rows": [
                    {
                        "label": {
                            "key": "{typesetter} Engine:",
                            "params": {
                                "typesetter": "AsciiDoc"
                            }
                        },
                        "value": {
                            "key": "Asciidoctor v2.0.26 - Asciidoctor PDF v2.3.24"
                        }
                    },
                    {
                        "label": {
                            "key": "Extensions:"
                        },
                        "value": {
                            "key": "asciidoctor-diagram, asciidoctor-bibtex, asciidoctor-reducer"
                        }
                    },
                    {
                        "label": {
                            "key": "Input Format:"
                        },
                        "value": {
                            "key": "AsciiDoc (.adoc)"
                        }
                    },
                    {
                        "label": {
                            "key": "Output Formats:"
                        },
                        "value": {
                            "key": "PDF, Canvas (PDF)"
                        }
                    },
                    {
                        "label": {
                            "key": "Export Formats:"
                        },
                        "value": {
                            "key": "PDF, HTML, EPUB, reveal.js, DOCX"
                        }
                    }
                ]
            }
        }
    }
}